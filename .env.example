# 이 파일을 .env 로 복사해서 값을 채웁니다. .env 는 git에 올리지 않습니다.

# DB
DB_ROOT_PASSWORD=

# 로그인 (JWT, 카카오·네이버)
JWT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 장소 데이터·지도
NAVER_SEARCH_ID=
NAVER_SEARCH_SECRET=
