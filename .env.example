# 이 파일을 .env 로 복사해서 값을 채웁니다. .env 는 git에 올리지 않습니다.

# DB (로컬은 MySQL root 비밀번호만 적으면 서버가 gaebalhagae DB와 테이블을 자동으로 만듭니다)
DB_ROOT_PASSWORD=
# DB_USERNAME=root
# DB_PASSWORD=          # 비우면 DB_ROOT_PASSWORD 사용

# 로그인 (JWT, 카카오·네이버)
JWT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 장소 데이터·지도
NAVER_SEARCH_ID=
NAVER_SEARCH_SECRET=
KAKAO_REST_KEY=
# 네이버 지도 JS SDK Client ID(ncpKeyId). VITE_ 로 시작해야 프론트에서 읽힘 — 브라우저에 공개되는 값이라 NCP 콘솔에서 서비스 URL(localhost:5173, 배포 주소)을 꼭 등록
VITE_NCP_MAP_KEY_ID=
TOUR_SERVICE_KEY=
# 자동 수집(카카오 → 블로그 → LLM 요약 → DB import). 켤 때만 true
COLLECT_SCHEDULE_ENABLED=
# 수집 시각(초 분 시 일 월 요일). 비우면 노트북(local) 매일 15:00, 배포 서버(prod) 매일 03:00. 한 달에 한 번: 0 0 3 1 * *
COLLECT_CRON=

# LLM 3개 (Gemini, Groq, OpenRouter)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# OpenRouter 무료 모델 이름 (비우면 nvidia/nemotron-3.5-super-vl:free). 무료 모델은 자주 내려가니 404 나면 https://openrouter.ai/models?q=free 에서 바꿈
OPENROUTER_MODEL=

# 프론트 주소 (로그인 후 돌아갈 곳)
FRONT_URL=http://localhost:5173
